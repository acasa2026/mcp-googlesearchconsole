# wrangler declares an optional peer dependency on @cloudflare/workers-types,
# and which version it asks for changes between wrangler releases. Since npm can
# resolve a different wrangler on different machines, that peer range is a moving
# target and pinning workers-types to match it just breaks somewhere else.
#
# workers-types is type definitions only, nothing is executed from it, so an
# unsatisfied peer range here is harmless. This tells npm to stop refusing the
# install over it.
legacy-peer-deps=true
